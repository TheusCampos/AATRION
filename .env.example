# ATRION / CVForge - configuração local
# Copie para .env.local. Nunca versionar segredos reais.

# Aplicação e banco
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# IA - configure pelo menos um provedor
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MAX=
STRIPE_PRICE_ID_UNIC=
STRIPE_PRICE_ID_PC_PRO=

# Cloudflare R2 (upload de fotos)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET_NAME=cvforge-uploads

# Rate limit - escolha REDIS_URL ou o par Upstash
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Busca de vagas
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Telemetria opcional
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cron de limpeza
CRON_SECRET=